# .env.example — JanMitra Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git — it is in .gitignore
# 4. Update this template whenever you add a new environment variable
# 5. All variables must be loaded via os.getenv() in Python — never hardcoded

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite scheme database (relative to backend/ directory)
DB_PATH=../data/janmitra_schemes.db

# ── Ollama Web Chatbot (Phase 3.5) ────────────────────────────────────────────
# Ollama runs locally — no API key needed. Install from https://ollama.com/download
# Then pull a model: ollama pull gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ── Google Gemini API (Phase 3) ────────────────────────────────────────────────
# Get your free key from: https://aistudio.google.com/app/apikey (no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended model: gemini-2.5-flash or gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
# Strict requirement from AGENTS.md: temperature must be 0.0 for scheme matching
GEMINI_TEMPERATURE=0.0

# ── Speech-to-Text (ASR) & Text-to-Speech (TTS) (Phase 3) ─────────────────────
# Primary: Google Cloud Speech & TTS (requires GCP service account JSON key)
# Download key from Google Cloud Console: IAM & Admin → Service Accounts → Create Key → JSON
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json

# Hindi language codes and default Google TTS voice
ASR_LANGUAGE_CODE=hi-IN
TTS_LANGUAGE_CODE=hi-IN
TTS_VOICE_NAME=hi-IN-Standard-A

# Speech Engines (with automatic zero-card fallbacks):
# ASR: "google_cloud" (default) or "speech_recognition" / "whisper" (free offline/web fallback)
ASR_ENGINE=google_cloud
# TTS: "google_cloud" (default) or "edge_tts" / "gtts" (free neural Hindi audio)
TTS_ENGINE=google_cloud
# Edge-TTS fallback voice: hi-IN-MadhurNeural (natural male) or hi-IN-SwaraNeural (natural female)
EDGE_TTS_VOICE=hi-IN-MadhurNeural

# ── Twilio (IVR + SMS) ─────────────────────────────────────────────────────────
# Find these in your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Your Twilio toll-free or trial number (with country code)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Server Configuration ───────────────────────────────────────────────────────
# Backend API base URL (used by frontend JS for fetch() calls)
API_BASE_URL=http://localhost:8000

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5500

# ── Evaluator Demo ─────────────────────────────────────────────────────────────
# Password for the /demo evaluator-only route (change before deployment)
EVALUATOR_DEMO_PASSWORD=changeme_before_deploy

# ── ngrok (Local Development — Twilio Webhooks) ────────────────────────────────
NGROK_PUBLIC_URL=https://your-ngrok-subdomain.ngrok.io

